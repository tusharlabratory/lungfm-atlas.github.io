---
import Base from "../../layouts/Base.astro";
import models from "../../data/models.json";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const fams = [...new Set(models.map((m) => m.family))];
const f3 = (x: number) => (x > 0 ? "+" : "") + x.toFixed(3).replace("-", "−");
---
<Base title="Models" active="/models" description="The 18 public CT foundation models in LungFM Atlas.">
  <div class="page-head"><div class="wrap">
    <h1>Foundation models</h1>
    <p>Eighteen pretrained encoders with publicly available weights, used frozen with each model's published preprocessing and read out at the annotated nodule or tumor. The badge gives the mean AUC difference from a random-weight encoder (same pipeline, no pretraining) in external testing.</p>
  </div></div>
  <div class="wrap">
    {fams.map((fam) => (
      <section>
        <h2 style="margin-top:0">{fam}</h2>
        <div class="grid">
          {models.filter((m) => m.family === fam).map((m) => {
            const v = m.vs_random["External test"];
            return (
              <a class="card" href={`${base}/models/${m.id}/`}>
                <div class="kicker">{m.dimensionality} · {m.pretraining_class}</div>
                <h3>{m.name}</h3>
                <p class="muted" style="margin:.2em 0 .6em;font-size:.9rem">{m.pretraining_data}</p>
                {v && <span class={`pill ${v.above ? "green" : ""}`}>vs random-weight {f3(v.diff[0])}{v.above ? " · above after Holm" : ""}</span>}
                {m.lung_cancer_labels && <span class="pill red">trained with lung cancer labels</span>}
              </a>
            );
          })}
        </div>
      </section>
    ))}
  </div>
</Base>
