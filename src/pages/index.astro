---
import Base from "../layouts/Base.astro";
import meta from "../data/meta.json";
import Findings from "../components/Findings.astro";
import PerThousand from "../components/PerThousand.astro";
import CaseGallery from "../components/CaseGallery.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const stats = [
  [meta.encoders, "public CT foundation models"], [meta.tasks, "lung cancer prediction tasks"],
  [meta.cohorts, "public CT cohorts"], [meta.participants, "participants"],
  [meta.units, "nodules or tumors"], [meta.setups, "model setups evaluated"],
];
const sections = [
  ["Build a comparison", "/build", "Pick tasks, cohorts and models as boxes; get the best performers in your selection and a figure you can download."],
  ["Network", "/network", "Graph of how encoders, pretraining types, cohorts and tasks connect: which models win which tasks, and which pretraining data overlap the study cohorts."],
  ["Explorer", "/explorer", "Heat map of every foundation model across every task: AUC, and the difference from nodule diameter, the Brock model, radiomics or the best comparator."],
  ["Models", "/models", "One card per encoder: architecture, pretraining data, pretraining overlap with the study cohorts and performance across all tasks."],
  ["Tasks and cohorts", "/tasks", "Each task and cohort: labels, size and source, with every encoder and comparator on the same test participants."],
  ["Model setups", "/setups", "All encoder × feature form × classifier combinations for a task, the setup selected in training data and the range expected by chance."],
  ["Which model?", "/guide", "Practical starting points and checks drawn from both papers, with the evidence behind each."],
  ["About and data", "/about", "Methods in brief, limitations, how to cite and downloadable result tables."],
];
---
<Base title="LungFM Atlas" active="/">
  <section class="hero">
    <div class="wrap">
      <span class="badge">Open benchmark · Lung cancer · CT</span>
      <h1>LungFM <span class="red">Atlas</span></h1>
      <p class="dept">Tushar Lab · Department of Radiology and Imaging Sciences · University of Arizona</p>
      <p class="lead">How well do publicly available CT foundation models predict lung cancer outcomes when used as frozen feature extractors? Explore {meta.encoders} encoders across {meta.tasks} tasks in {meta.cohorts} public cohorts, compared with nodule diameter, the Brock model and radiomics.</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:22px">
        <a class="btn btn-primary" href={`${base}/build/`}>Build a comparison</a>
        <a class="btn btn-outline" href={`${base}/explorer/`}>Open the explorer</a>
        <a class="btn btn-outline" href={`${base}/network/`}>See the network</a>
      </div>
      <div class="stats">
        {stats.map(([n, l]) => <div class="stat"><b>{n}</b><span>{l}</span></div>)}
      </div>
    </div>
  </section>
  <div style="background:var(--panel);border-bottom:1px solid var(--line)">
    <div class="wrap affil">
      <a href="https://tusharlabratory.github.io/" aria-label="Tushar Lab"><img class="lab" src={`${base}/brand/tusharlab-logo-crop.svg`} alt="Tushar Lab" /></a>
      <span class="div" aria-hidden="true"></span>
      <a href="https://radiology.arizona.edu/" aria-label="Department of Radiology and Imaging Sciences, University of Arizona"><img class="dept" src={`${base}/brand/radiology-imaging-sciences.png`} alt="Radiology and Imaging Sciences, University of Arizona" /></a>
    </div>
  </div>

  <section>
    <div class="wrap">
      <h2 style="margin-top:0">Key findings</h2>
      <p class="muted" style="max-width:820px">Six results from the two articles. Each number comes straight from the papers; open "Full statement" for the exact wording. AUC = area under the receiver operating characteristic curve; error bars are 95% CIs.</p>
      <Findings />
      <h3 style="font-size:1.35rem;margin:30px 0 4px">What this means per 1000 screening nodules</h3>
      <p class="muted" style="max-width:860px;margin-bottom:14px">The clinical operating point in the two screening cohorts: each score compared with the common rule of flagging nodules 8 mm or larger.</p>
      <PerThousand />
      <h3 style="font-size:1.35rem;margin:30px 0 4px">Example nodules</h3>
      <p class="muted" style="max-width:860px;margin-bottom:14px">Eight screening nodules and where each score ranks them in their cohort: cancers flagged by the foundation model only, by the 8-mm threshold only, or by neither, and a benign nodule flagged by both.</p>
      <CaseGallery />
      <div style="height:22px"></div>
      <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(320px,1fr));margin-top:8px">
        <div class="card"><div class="kicker">In one sentence · clinical value</div><p style="margin:.4em 0 0">{meta.summary1}</p></div>
        <div class="card"><div class="kicker">In one sentence · what drives performance</div><p style="margin:.4em 0 0">{meta.summary1b}</p></div>
      </div>
    </div>
  </section>

  <section style="background:var(--panel)">
    <div class="wrap">
      <h2 style="margin-top:0">Explore the results</h2>
      <div class="grid">
        {sections.map(([t, href, d]) => (
          <a class="card" href={`${base}${href}/`}><div class="kicker">Explore</div><h3>{t}</h3><p class="muted" style="margin:0">{d}</p></a>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2 style="margin-top:0">The studies</h2>
      <div class="grid">
        <div class="card"><div class="kicker">Article 1 · clinical value</div><h3>{meta.title1}</h3><p class="muted" style="margin:0">Preprint link coming soon.</p></div>
        <div class="card"><div class="kicker">Article 2 · what drives performance</div><h3>{meta.title1b}</h3><p class="muted" style="margin:0">Preprint link coming soon.</p></div>
      </div>
    </div>
  </section>
</Base>
