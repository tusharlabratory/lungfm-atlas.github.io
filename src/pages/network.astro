---
import Base from "../layouts/Base.astro";
import meta from "../data/meta.json";
---
<Base title="Network" active="/network" description="Graph of CT foundation models, pretraining types, study cohorts and lung cancer tasks, linked by performance and pretraining overlap.">
  <div class="page-head"><div class="wrap">
    <h1>Network</h1>
    <p>How the encoders, their pretraining types, the study cohorts and the tasks connect. Links show which encoders perform best in which tasks and whose pretraining data overlap a study cohort. Select a node for details.</p>
  </div></div>
  <div class="wrap">
    <div class="netstats">
      <div><span>Encoders</span><b>{meta.encoders}</b></div>
      <div><span>Tasks</span><b>{meta.tasks}</b></div>
      <div><span>Cohorts</span><b>{meta.cohorts}</b></div>
      <div><span>Links shown</span><b id="nlinks">–</b></div>
    </div>
    <div class="netgrid">
      <div class="netcard">
        <label class="lab" for="q">Search the network</label>
        <input id="q" type="search" placeholder="Model, task or cohort name (at least 2 letters)" autocomplete="off" />
        <div class="controls" style="margin:14px 0 10px">
          <label>Performance links
            <select id="perf">
              <option value="top3" selected>Three highest AUCs in each task</option>
              <option value="above">95% CI above the best comparator</option>
              <option value="diam">95% CI above diameter</option>
              <option value="auc">AUC at or above a threshold</option>
              <option value="none">None</option>
            </select>
          </label>
          <label id="thrlab" style="display:none">Threshold <span><input id="thr" type="range" min="0.6" max="0.9" step="0.01" value="0.75" /> <b id="thrv">0.75</b></span></label>
          <label>Layout
            <div class="seg" id="layout"><button data-v="force" class="on">Force</button><button data-v="cols">Columns</button></div>
          </label>
          <label>Show
            <span class="checks">
              <label><input type="checkbox" id="sOverlap" checked /> Pretraining overlap</label>
              <label><input type="checkbox" id="sType" checked /> Pretraining type</label>
            </span>
          </label>
        </div>
        <div class="legend" id="legend"></div>
        <p class="muted" style="font-size:.84rem;margin:2px 0 8px" id="caption"></p>
        <div class="zoom"><button id="zin" aria-label="Zoom in">+</button><button id="zout" aria-label="Zoom out">−</button><button id="zreset">Reset</button></div>
        <svg id="net" role="img" aria-label="Network of encoders, tasks, cohorts and pretraining types"></svg>
      </div>
      <aside class="netcard side" id="side">
        <h3 style="margin-top:0">Details</h3>
        <p class="muted">Select a node in the graph, or search, to see its links: an encoder's best tasks, a task's leading encoders and comparators, or a cohort's overlap with pretraining data.</p>
      </aside>
    </div>
    <p class="note" style="margin-top:16px">Performance links use each encoder in its setup chosen in training data, in the task's main setting (external test, or within cohort with cross-validation). "Best comparator" is the comparator with the highest AUC in the task, chosen with the test labels, which favors the comparator. Ranks within a task are descriptive: intervals overlap widely. C index for survival.</p>
  </div>
</Base>

<style is:global>
  .netstats { display: flex; gap: 40px; flex-wrap: wrap; justify-content: center; margin: 22px 0 18px; }
  .netstats div span { display: block; font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .netstats div b { font-family: var(--font-head); font-size: 1.9rem; color: var(--head); font-variant-numeric: tabular-nums; }
  .netgrid { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 20px; align-items: start; }
  @media (max-width: 1000px) { .netgrid { grid-template-columns: 1fr; } }
  .netcard { background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 18px 20px; box-shadow: var(--shadow); }
  .netcard .lab { display: block; font-size: .75rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--head); margin-bottom: 6px; }
  .netcard input[type="search"] { width: 100%; min-width: 0; padding: 10px 12px; font-size: .95rem; }
  .side { position: sticky; top: 84px; max-height: calc(100vh - 100px); overflow: auto; }
  .side .row { display: flex; justify-content: space-between; gap: 10px; padding: 5px 0; border-bottom: 1px solid var(--line); font-size: .88rem; }
  .side .row span:last-child { font-variant-numeric: tabular-nums; white-space: nowrap; }
  .side h4 { font-family: var(--font); font-size: .74rem; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin: 16px 0 4px; }
  .side .box { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; margin-top: 12px; }
  .checks { display: flex; gap: 14px; flex-wrap: wrap; text-transform: none; letter-spacing: 0; font-weight: 500; font-size: .88rem; color: var(--ink); padding-top: 6px; }
  .checks label { flex-direction: row !important; align-items: center; gap: 6px !important; font-size: .88rem !important; text-transform: none !important; letter-spacing: 0 !important; color: var(--ink) !important; font-weight: 500 !important; }
  .zoom { display: flex; justify-content: flex-end; gap: 6px; }
  .zoom button { font: inherit; font-size: .85rem; font-weight: 700; border: 1px solid #cbd5e1; background: #f8fafc; border-radius: 6px; padding: 4px 12px; cursor: pointer; color: var(--head); }
  .zoom button:hover { border-color: var(--az-red); color: var(--az-red); }
  #net { width: 100%; height: 720px; display: block; cursor: grab; touch-action: none; }
  #net text { font-family: var(--font); pointer-events: none; paint-order: stroke; stroke: #fff; stroke-width: 3px; stroke-linejoin: round; }
  #net .node { cursor: pointer; }
  #net .dim { opacity: .12; }
  .lg-sym { display: inline-flex; align-items: center; gap: 6px; margin-right: 12px; }
</style>

<script>
  import { forceSimulation, forceLink, forceManyBody, forceCollide, forceX, forceY } from "d3-force";
  import { select } from "d3-selection";
  import { zoom, zoomIdentity } from "d3-zoom";
  import { drag } from "d3-drag";
  import { getJSON, ci2, ci3, f2, BASE, tooltip, taskLabel, FAMILY_COLOR, parseOverlap } from "../scripts/lib.js";

  const tip = tooltip();
  const [tasks, cells, models, cohorts] = await Promise.all([getJSON("tasks.json"), getJSON("task_models.json"), getJSON("models.json"), getJSON("cohorts.json")]);
  const C = { task: "#0C234B", cohortFill: "#E5EFF7", cohortStroke: "#1E5288", type: "#7F8B5A", perf: "#106AB1", overlap: "#AB0520", struct: "#B8C2CE" };
  const cohortNames = cohorts.map((c) => c.name);
  const enc = cells.filter((c) => c.kind === "encoder");
  const cell = (tid, m) => cells.find((c) => c.task === tid && c.model === m);

  // ---- nodes
  const nodes = [];
  const TYPES = [...new Set(models.map((m) => m.pretraining_class))];
  TYPES.forEach((t) => nodes.push({ id: `type:${t}`, kind: "type", name: t, label: t }));
  models.forEach((m) => nodes.push({ id: `enc:${m.name}`, kind: "enc", name: m.name, label: m.name, m, color: FAMILY_COLOR[m.family], unknown: /^Unknown/.test(m.overlap) }));
  tasks.forEach((t) => nodes.push({ id: `task:${t.id}`, kind: "task", name: t.id, label: taskLabel(t), t }));
  cohorts.forEach((c) => nodes.push({ id: `coh:${c.name}`, kind: "coh", name: c.name, label: c.name, c,
    participants: tasks.filter((t) => t.cohort === c.name).reduce((a, t) => Math.max(a, t.participants), 0) }));
  const byId = new Map(nodes.map((n) => [n.id, n]));

  // ---- fixed links
  const structural = [];
  models.forEach((m) => structural.push({ source: `enc:${m.name}`, target: `type:${m.pretraining_class}`, kind: "type" }));
  tasks.forEach((t) => structural.push({ source: `task:${t.id}`, target: `coh:${t.cohort}`, kind: "cohort" }));
  const overlapLinks = [];
  models.forEach((m) => parseOverlap(m.overlap, cohortNames).forEach((o) => overlapLinks.push({ source: `enc:${m.name}`, target: `coh:${o.cohort}`, kind: o.kind })));

  function perfLinks(mode, thr) {
    if (mode === "none") return [];
    const out = [];
    tasks.forEach((t) => {
      const cs = enc.filter((c) => c.task === t.id && !c.excluded && c.auc);
      let keep;
      if (mode === "top3") keep = [...cs].sort((a, b) => b.auc[0] - a.auc[0]).slice(0, 3);
      else if (mode === "above") keep = cs.filter((c) => c.vs && c.vs.best && c.vs.best[1] > 0);
      else if (mode === "diam") keep = cs.filter((c) => c.vs && c.vs.diameter && c.vs.diameter[1] > 0);
      else keep = cs.filter((c) => c.auc[0] >= thr);
      keep.forEach((c) => out.push({ source: `enc:${c.model}`, target: `task:${t.id}`, kind: "perf", auc: c.auc[0], c }));
    });
    return out;
  }

  // ---- svg
  const svg = select("#net");
  const W = () => svg.node().clientWidth, H = 720;
  const root = svg.append("g");
  const gL = root.append("g"), gN = root.append("g"), gT = root.append("g");
  const zb = zoom().scaleExtent([0.3, 4]).on("zoom", (e) => root.attr("transform", e.transform));
  svg.call(zb).on("dblclick.zoom", null);
  document.getElementById("zin").onclick = () => svg.call(zb.scaleBy, 1.3);
  document.getElementById("zout").onclick = () => svg.call(zb.scaleBy, 1 / 1.3);
  document.getElementById("zreset").onclick = () => { fit(); select_(null); };

  const st = { perf: "top3", thr: 0.75, layout: "force", overlap: true, type: true, sel: null };
  let links = [], sim;

  const radius = (n) => n.kind === "enc" ? 7 + 1.5 * (n.deg || 0) : n.kind === "task" ? 5 + 1.6 * Math.log10(n.t.n) : n.kind === "coh" ? 6 + 1.8 * Math.log10(n.participants || 10) : 9;
  function shape(n) {
    const r = radius(n);
    if (n.kind === "enc") return `M${-r},0a${r},${r} 0 1,0 ${2 * r},0a${r},${r} 0 1,0 ${-2 * r},0`;
    if (n.kind === "task") return `M${-r},${-r}h${2 * r}v${2 * r}h${-2 * r}z`;
    if (n.kind === "type") return `M0,${-r * 1.3}L${r * 1.3},0L0,${r * 1.3}L${-r * 1.3},0z`;
    const a = r * 1.15, b = r * 0.95; // hexagon for cohorts
    return `M${-a},0L${-a / 2},${-b}L${a / 2},${-b}L${a},0L${a / 2},${b}L${-a / 2},${b}z`;
  }
  const fill = (n) => n.kind === "enc" ? n.color : n.kind === "task" ? C.task : n.kind === "type" ? C.type : C.cohortFill;
  const stroke = (n) => n.kind === "coh" ? C.cohortStroke : n.kind === "enc" && n.m.family.startsWith("2D") ? "#106AB1" : "#fff";

  function colTargets() {
    const w = W(), pad = 60;
    const col = (list, x) => list.forEach((n, i) => { n.tx = x; n.ty = pad + (i + 0.5) * (H - 2 * pad) / list.length; });
    col(nodes.filter((n) => n.kind === "type"), w * 0.07);
    const fam = Object.keys(FAMILY_COLOR);
    col(nodes.filter((n) => n.kind === "enc").sort((a, b) => fam.indexOf(a.m.family) - fam.indexOf(b.m.family) || a.name.localeCompare(b.name)), w * 0.33);
    col(nodes.filter((n) => n.kind === "task"), w * 0.66);
    col(nodes.filter((n) => n.kind === "coh"), w * 0.9);
  }

  function build() {
    const perf = perfLinks(st.perf, st.thr);
    nodes.forEach((n) => (n.deg = 0));
    perf.forEach((l) => byId.get(l.source).deg++);
    links = [...structural.filter((l) => l.kind === "cohort" || st.type), ...(st.overlap ? overlapLinks : []), ...perf].map((l) => ({ ...l }));
    document.getElementById("nlinks").textContent = links.length;

    const ls = gL.selectAll("line").data(links).join("line")
      .attr("stroke", (l) => l.kind === "perf" ? C.perf : l.kind === "excluded" || l.kind === "plausible" ? C.overlap : C.struct)
      .attr("stroke-width", (l) => l.kind === "perf" ? 1 + 10 * Math.max(0, l.auc - 0.5) : l.kind === "excluded" ? 2.2 : l.kind === "plausible" ? 1.6 : 1.2)
      .attr("stroke-dasharray", (l) => l.kind === "plausible" ? "5 4" : null)
      .attr("stroke-opacity", (l) => l.kind === "perf" ? 0.55 : 0.9);
    const ns = gN.selectAll("path").data(nodes, (n) => n.id).join("path").attr("class", "node")
      .attr("d", shape).attr("fill", fill).attr("stroke", stroke).attr("stroke-width", (n) => n.kind === "coh" ? 1.6 : 1.4)
      .attr("stroke-dasharray", (n) => n.unknown ? "3 2" : null);
    const ts = gT.selectAll("text").data(nodes, (n) => n.id).join("text")
      .text((n) => n.label).attr("font-size", (n) => n.kind === "type" ? 12 : 11)
      .attr("font-weight", (n) => n.kind === "type" || n.kind === "coh" ? 700 : 500)
      .attr("fill", (n) => n.kind === "type" ? "#4c5634" : n.kind === "enc" && n.m.family.startsWith("Lung") ? "#850000" : "#0f172a")
      .attr("text-anchor", (n) => st.layout === "cols" && (n.kind === "enc" || n.kind === "type") ? "end" : st.layout === "cols" ? "start" : "middle");

    ns.on("mousemove", (ev, n) => tip.show(tipHtml(n), ev)).on("mouseleave", () => tip.hide())
      .on("click", (ev, n) => { ev.stopPropagation(); select_(n); });
    svg.on("click", () => select_(null));
    ns.call(drag().on("start", (e, n) => { if (!e.active) sim.alphaTarget(0.2).restart(); n.fx = n.x; n.fy = n.y; })
      .on("drag", (e, n) => { n.fx = e.x; n.fy = e.y; })
      .on("end", (e, n) => { if (!e.active) sim.alphaTarget(0); if (st.layout === "force") { n.fx = null; n.fy = null; } }));

    if (sim) sim.stop();
    const w = W();
    if (st.layout === "cols") colTargets();
    sim = forceSimulation(nodes)
      .force("link", forceLink(links).id((n) => n.id).distance((l) => l.kind === "cohort" ? 40 : l.kind === "type" ? 90 : 120).strength((l) => st.layout === "cols" ? 0 : l.kind === "perf" ? 0.25 : 0.6))
      .force("charge", forceManyBody().strength(st.layout === "cols" ? 0 : -520).distanceMax(500))
      .force("collide", forceCollide().radius((n) => radius(n) + (st.layout === "cols" ? 2 : 22)))
      .force("x", forceX((n) => st.layout === "cols" ? n.tx : w / 2).strength(st.layout === "cols" ? 1 : 0.035))
      .force("y", forceY((n) => st.layout === "cols" ? n.ty : H / 2).strength(st.layout === "cols" ? 1 : 0.06))
      .on("tick", () => {
                ls.attr("x1", (l) => l.source.x).attr("y1", (l) => l.source.y).attr("x2", (l) => l.target.x).attr("y2", (l) => l.target.y);
        ns.attr("transform", (n) => `translate(${n.x},${n.y})`);
        ts.attr("x", (n) => st.layout === "cols" ? n.x + ((n.kind === "enc" || n.kind === "type") ? -radius(n) - 6 : radius(n) + 6) : n.x)
          .attr("y", (n) => st.layout === "cols" ? n.y + 4 : n.y + radius(n) + 12);
      });
    sim.on("end", fit);
    if (st.layout === "force") sim.alpha(1).restart();
    highlight();
    caption();
  }

  // zoom so the whole graph, labels included, fills the frame
  function fit() {
    const w = W(), xs = nodes.map((n) => n.x), ys = nodes.map((n) => n.y);
    const x0 = Math.min(...xs) - 90, x1 = Math.max(...xs) + 90, y0 = Math.min(...ys) - 30, y1 = Math.max(...ys) + 40;
    const k = Math.min(1.6, w / (x1 - x0), H / (y1 - y0));
    svg.call(zb.transform, zoomIdentity.translate((w - k * (x0 + x1)) / 2, (H - k * (y0 + y1)) / 2).scale(k));
  }
  function neighbors(n) {
    const s = new Set([n.id]);
    links.forEach((l) => { if (l.source.id === n.id) s.add(l.target.id); if (l.target.id === n.id) s.add(l.source.id); });
    return s;
  }
  function highlight(match) {
    const sel = st.sel;
    const keep = sel ? neighbors(sel) : match ? new Set(match.map((n) => n.id)) : null;
    gN.selectAll("path").classed("dim", (n) => keep && !keep.has(n.id)).attr("stroke-width", (n) => sel && n.id === sel.id ? 3.5 : n.kind === "coh" ? 1.6 : 1.4)
      .attr("stroke", (n) => sel && n.id === sel.id ? "#AB0520" : stroke(n));
    gT.selectAll("text").classed("dim", (n) => keep && !keep.has(n.id));
    gL.selectAll("line").classed("dim", (l) => keep && !(keep.has(l.source.id) && keep.has(l.target.id) && (!sel || l.source.id === sel.id || l.target.id === sel.id)));
  }

  const kindName = { enc: "Encoder", task: "Task", coh: "Cohort", type: "Pretraining type" };
  function tipHtml(n) {
    let h = `<b>${n.kind === "task" ? `${n.t.cohort} · ${n.t.task}` : n.name}</b><br><span style="opacity:.8">${kindName[n.kind]}</span>`;
    if (n.kind === "enc") h += `<br>${n.m.family}<br>${n.m.pretraining_class}`;
    if (n.kind === "task") h += `<br>${n.t.n} units, ${n.t.participants} participants<br>${n.t.main_setting}`;
    if (n.kind === "coh") h += `<br>${n.c.source}`;
    return h;
  }

  function select_(n) {
    st.sel = n;
    highlight();
    const side = document.getElementById("side");
    if (!n) { side.innerHTML = `<h3 style="margin-top:0">Details</h3><p class="muted">Select a node in the graph, or search, to see its links.</p>`; return; }
    const un = `<button class="mini" id="unsel" style="float:right;border:1px solid #cbd5e1;border-radius:6px;padding:3px 9px;color:var(--head)">Unselect</button>`;
    let h = `${un}<div class="kicker" style="font-size:.74rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--az-red)">${kindName[n.kind]}</div>`;
    if (n.kind === "enc") {
      const m = n.m, mine = enc.filter((c) => c.model === m.name);
      const rows = mine.filter((c) => !c.excluded).sort((a, b) => b.auc[0] - a.auc[0]);
      const above = mine.filter((c) => c.vs?.best && c.vs.best[1] > 0);
      h += `<h3 style="margin:.2em 0 .3em">${m.name}</h3><p class="muted" style="font-size:.86rem;margin:0">${m.family} · ${m.pretraining_class}<br>${m.pretraining_data}</p>
        <div class="box"><b>${above.length}</b> of ${rows.length} tasks with the 95% CI above the best comparator${above.length ? ": " + above.map((c) => taskLabel(tasks.find((t) => t.id === c.task))).join(", ") : ""}.</div>
        <h4>AUC by task, highest first</h4>${rows.map((c) => `<div class="row"><span>${taskLabel(tasks.find((t) => t.id === c.task))}</span><span>${ci2(c.auc)}</span></div>`).join("")}
        ${mine.some((c) => c.excluded) ? `<h4>Excluded for pretraining overlap</h4><p style="font-size:.86rem">${mine.filter((c) => c.excluded).map((c) => taskLabel(tasks.find((t) => t.id === c.task))).join(", ")}</p>` : ""}
        <h4>Pretraining overlap</h4><p style="font-size:.86rem">${m.overlap}</p>
        <p><a href="${BASE}/models/${m.id}/">Open the model page →</a></p>`;
    } else if (n.kind === "task") {
      const t = n.t, cs = enc.filter((c) => c.task === t.id && !c.excluded).sort((a, b) => b.auc[0] - a.auc[0]);
      const comp = cells.filter((c) => c.task === t.id && c.kind !== "encoder").sort((a, b) => b.auc[0] - a.auc[0]);
      h += `<h3 style="margin:.2em 0 .3em">${t.cohort} · ${t.task}</h3><p class="muted" style="font-size:.86rem;margin:0">${t.group} · ${t.main_setting} · ${t.n} units, ${t.participants} participants, ${t.n_pos} positive</p>
        <div class="box">Selected FM setup: <b>${t.selected_setup}</b><br>${t.metric} ${ci2(t.selected)}${t.chance && t.chance[0] != null ? `<br><span class="muted">Range expected by chance ${f2(t.chance[0])}–${f2(t.chance[1])}</span>` : ""}</div>
        <h4>Encoders, highest ${t.metric} first</h4>${cs.slice(0, 8).map((c, i) => `<div class="row"><span>${i + 1}. ${c.model}</span><span>${ci2(c.auc)}</span></div>`).join("")}
        <h4>Comparators and control</h4>${comp.map((c) => `<div class="row"><span><i>${c.model}</i></span><span>${ci2(c.auc)}</span></div>`).join("")}
        <p><a href="${BASE}/tasks/${t.id}/">Open the task page →</a></p>`;
    } else if (n.kind === "coh") {
      const c = n.c, tk = tasks.filter((t) => t.cohort === c.name);
      const ov = overlapLinks.filter((l) => (l.target.id ?? l.target) === n.id);
      h += `<h3 style="margin:.2em 0 .3em">${c.name}</h3><p class="muted" style="font-size:.86rem;margin:0">${c.source}<br>${c.ct}</p>
        <h4>Tasks</h4>${tk.map((t) => `<div class="row"><span><a href="${BASE}/tasks/${t.id}/">${t.task}</a></span><span>${t.participants} participants</span></div>`).join("")}
        <div class="box"><b>Pretraining overlap</b><br>${ov.length ? ov.map((l) => `${(l.source.name ?? l.source.replace("enc:", ""))}: ${l.kind === "excluded" ? "in pretraining data, excluded" : "plausible, included (excluded in the strict sensitivity analysis)"}`).join("<br>") : "None recorded."}<br><span class="muted" style="font-size:.8rem">MedicalNet and both nnFoundation models: overlap unknown for every cohort.</span></div>
        <h4>Reference standard</h4><p style="font-size:.86rem">${c.reference_standard}</p>
        ${c.doi ? `<p style="font-size:.86rem"><a href="https://doi.org/${c.doi}">Source: doi:${c.doi}</a></p>` : ""}`;
    } else {
      const ms = models.filter((m) => m.pretraining_class === n.name);
      h += `<h3 style="margin:.2em 0 .3em">${n.name}</h3><h4>${ms.length} encoders</h4>${ms.map((m) => `<div class="row"><span><a href="${BASE}/models/${m.id}/">${m.name}</a></span><span class="muted">${m.family.replace(" encoders", "")}</span></div>`).join("")}`;
    }
    side.innerHTML = h;
    document.getElementById("unsel").onclick = () => select_(null);
  }

  function caption() {
    const txt = { top3: "Blue links join each task to its three encoders with the highest AUC.", above: "Blue links join a task to each encoder whose 95% CI of the difference from the best comparator lies above 0.",
      diam: "Blue links join a task to each encoder whose 95% CI of the difference from nodule diameter lies above 0.", auc: `Blue links join a task to each encoder with AUC at or above ${st.thr.toFixed(2)}.`, none: "No performance links." }[st.perf];
    document.getElementById("caption").textContent = `${txt} Thicker links mean higher AUC. Larger circles have more performance links; larger squares and hexagons hold more nodules or participants.`;
  }

  const sym = (d, f, s, dash) => `<svg width="16" height="16" viewBox="-8 -8 16 16"><path d="${d}" fill="${f}" stroke="${s}" stroke-width="1.4" ${dash ? 'stroke-dasharray="3 2"' : ""}/></svg>`;
  const circ = "M-6,0a6,6 0 1,0 12,0a6,6 0 1,0 -12,0";
  document.getElementById("legend").innerHTML =
    Object.entries(FAMILY_COLOR).map(([k, v]) => `<span class="lg-sym">${sym(circ, v, k.startsWith("2D") ? "#106AB1" : v)}${k}</span>`).join("") +
    `<span class="lg-sym">${sym(circ, "#fff", "#545f6b", true)}Overlap unknown</span>` +
    `<span class="lg-sym">${sym("M-6,-6h12v12h-12z", C.task, C.task)}Task</span>` +
    `<span class="lg-sym">${sym("M-7,0L-3.5,-6L3.5,-6L7,0L3.5,6L-3.5,6z", C.cohortFill, C.cohortStroke)}Cohort</span>` +
    `<span class="lg-sym">${sym("M0,-7L7,0L0,7L-7,0z", C.type, C.type)}Pretraining type</span>` +
    `<span class="lg-sym"><svg width="26" height="10"><line x1="0" y1="5" x2="26" y2="5" stroke="${C.perf}" stroke-width="3" opacity=".6"/></svg>Performance</span>` +
    `<span class="lg-sym"><svg width="26" height="10"><line x1="0" y1="5" x2="26" y2="5" stroke="${C.overlap}" stroke-width="2.2"/></svg>Overlap, excluded</span>` +
    `<span class="lg-sym"><svg width="26" height="10"><line x1="0" y1="5" x2="26" y2="5" stroke="${C.overlap}" stroke-width="1.6" stroke-dasharray="5 4"/></svg>Overlap plausible</span>`;

  // controls
  document.getElementById("perf").onchange = (e) => { st.perf = e.target.value; document.getElementById("thrlab").style.display = st.perf === "auc" ? "" : "none"; build(); };
  document.getElementById("thr").oninput = (e) => { st.thr = +e.target.value; document.getElementById("thrv").textContent = st.thr.toFixed(2); build(); };
  document.getElementById("sOverlap").onchange = (e) => { st.overlap = e.target.checked; build(); };
  document.getElementById("sType").onchange = (e) => { st.type = e.target.checked; build(); };
  document.getElementById("layout").addEventListener("click", (e) => {
    const b = e.target.closest("button"); if (!b) return;
    [...b.parentNode.children].forEach((x) => x.classList.toggle("on", x === b));
    st.layout = b.dataset.v;
    nodes.forEach((n) => { n.fx = null; n.fy = null; });
    build();
    if (st.layout === "cols") { sim.alpha(1); for (let i = 0; i < 200; i++) sim.tick(); sim.stop(); sim.on("tick")(); svg.call(zb.transform, zoomIdentity); }
  });
  document.getElementById("q").addEventListener("input", (e) => {
    const q = e.target.value.trim().toLowerCase();
    if (q.length < 2) { st.sel = null; highlight(); return; }
    const hits = nodes.filter((n) => n.label.toLowerCase().includes(q) || n.name.toLowerCase().includes(q));
    if (hits.length === 1) select_(hits[0]); else { st.sel = null; highlight(hits); }
  });
  build();
  // deep link: ?select=enc:Sybil
  const pre = new URLSearchParams(location.search).get("select");
  if (pre && byId.get(pre)) setTimeout(() => select_(byId.get(pre)), 300);
</script>
