---
// Paper 1 Figure 6 A and B as web panels: cancers and benign nodules flagged per 1000 nodules at the 8-mm operating
// point. All values come from meta.highlights.per1000 (exported from the Paper 1 numbers file by p40_site_export.py).
import meta from "../data/meta.json";
const P = (meta as any).highlights.per1000 as any[];
const F = "DM Sans, Arial, sans-serif";
const INK = "#1E293B", MUTED = "#64748B";
const sg = (x: number) => (x > 0 ? "+" : x < 0 ? "−" : "") + Math.abs(x).toFixed(1);
const nm = (x: number) => (x < 0 ? "−" : "") + Math.abs(x).toFixed(1);
const t = (x: number, y: number, s: string, o: any = {}) =>
  `<text x="${x}" y="${y}" font-family="${F}" font-size="${o.size ?? 12}" fill="${o.fill ?? INK}"${o.anchor ? ` text-anchor="${o.anchor}"` : ""}${o.weight ? ` font-weight="${o.weight}"` : ""}>${s}</text>`;
const short = (r: any) => r.kind === "lungrads" ? "Lung-RADS (per examination)" : r.kind === "fm" ? r.name.replace("Selected FM setup", "Selected FM") : r.name;
function marker(kind: string, x: number, y: number) {
  if (kind === "ref") return `<rect x="${x - 6}" y="${y - 6}" width="12" height="12" fill="#E08996" stroke="#AB0520" stroke-width="1.6"/>`;
  if (kind === "brock") return `<path d="M${x},${y - 7}L${x + 7},${y + 5}L${x - 7},${y + 5}Z" fill="#5FB0DA" stroke="#106AB1" stroke-width="1.5"/>`;
  if (kind === "lungrads") return `<path d="M${x},${y - 7}L${x + 7},${y}L${x},${y + 7}L${x - 7},${y}Z" fill="#fff" stroke="#106AB1" stroke-width="1.8"/>`;
  return `<circle cx="${x}" cy="${y}" r="6.5" fill="#0C234B"/>`;
}
const colOf = (kind: string) => (kind === "fm" ? "#0C234B" : "#106AB1");

function panel(which: "a" | "b") {
  const W = 560, L = 190, R = 150, rowH = 26;
  const [lo, hi, ticks] = which === "a" ? [-12, 32, [-10, 0, 10, 20, 30]] : [-110, 110, [-100, -50, 0, 50, 100]];
  const X = (v: number) => L + ((v - lo) / (hi - lo)) * (W - L - R);
  let y = 6, g = "";
  for (const c of P) {
    y += 20;
    g += t(0, y, `<tspan font-weight="700">${c.cohort}</tspan><tspan fill="${MUTED}"> · ${c.nodules} nodules, ${c.pct_pos}% malignant</tspan>`, { size: 12 });
    g += t(W, y, which === "a" ? `each score flags ${c.flagged}` : `sensitivity fixed at ${c.target_sens.toFixed(2)}`, { anchor: "end", size: 11, fill: MUTED });
    const top = y + 8;
    for (const r of c[which]) {
      y += rowH;
      const cy = y - 8;
      g += t(12, cy + 4, short(r), { size: 12, weight: r.kind === "fm" ? 700 : 500 });
      if (r.kind === "ref") {
        g += marker("ref", X(0), cy);
        g += t(W, cy + 4, `rate ${nm(r.rate[0])} (${nm(r.rate[1])}, ${nm(r.rate[2])})${which === "b" ? "†" : ""}`, { anchor: "end", size: 12, weight: 600 });
      } else {
        const d = r.diff;
        g += `<line x1="${X(d[1])}" x2="${X(d[2])}" y1="${cy}" y2="${cy}" stroke="${colOf(r.kind)}" stroke-width="2"/>` +
          `<line x1="${X(d[1])}" x2="${X(d[1])}" y1="${cy - 4}" y2="${cy + 4}" stroke="${colOf(r.kind)}" stroke-width="2"/><line x1="${X(d[2])}" x2="${X(d[2])}" y1="${cy - 4}" y2="${cy + 4}" stroke="${colOf(r.kind)}" stroke-width="2"/>`;
        g += marker(r.kind, X(d[0]), cy);
        const sig = d[1] > 0 || d[2] < 0;
        g += t(W, cy + 4, `${sg(d[0])} (${nm(d[1])}, ${nm(d[2])})${r.sens ? "‡" : ""}`, { anchor: "end", size: 12, weight: sig ? 700 : 400 });
      }
    }
    g = `<line x1="${X(0)}" x2="${X(0)}" y1="${top}" y2="${y + 2}" stroke="${INK}" stroke-width="1"/>` + g;
    y += 10;
  }
  const ay = y + 4;
  let a = `<line x1="${X(lo)}" x2="${X(hi)}" y1="${ay}" y2="${ay}" stroke="${INK}"/>`;
  for (const v of ticks as number[]) a += `<line x1="${X(v)}" x2="${X(v)}" y1="${ay}" y2="${ay + 4}" stroke="${INK}"/>` + t(X(v), ay + 17, v < 0 ? `−${-v}` : String(v), { anchor: "middle", size: 11 });
  a += t(X(lo), ay + 32, "← fewer", { size: 11, fill: MUTED }) + t(X(hi), ay + 32, "more →", { anchor: "end", size: 11, fill: MUTED });
  a += t((X(lo) + X(hi)) / 2, ay + 50, which === "a" ? "Difference in cancers flagged per 1000 nodules" : "Difference in benign nodules flagged per 1000 nodules", { anchor: "middle", size: 12, weight: 600 });
  const H = ay + 58;
  return `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="${which === "a" ? "Cancers flagged per 1000 nodules" : "Benign nodules flagged per 1000 nodules"} compared with the 8-mm threshold">${g}${a}</svg>`;
}

// plain-language lines, built from the same numbers
const fmA = P.map((c) => c.a.find((r: any) => r.kind === "fm"));
const fmB = P.map((c) => c.b.find((r: any) => r.kind === "fm"));
const inc0 = (d: number[]) => d[1] <= 0 && d[2] >= 0;
const lrA = P[0].a.find((r: any) => r.kind === "lungrads"), lrB = P[0].b.find((r: any) => r.kind === "lungrads");
const cutoff = P[0].cutoff_mm.toFixed(2);
---
<div class="pt">
  <div class="ptgrid">
    <figure>
      <figcaption><span class="pl">A</span> Cancers flagged <small>when every score flags as many nodules as the 8-mm threshold</small></figcaption>
      <div set:html={panel("a")} />
      <p class="take">{fmA.every((d: any) => inc0(d.diff)) ? "The selected foundation model setups flagged about as many cancers as the 8-mm threshold (both 95% CIs include 0)." : ""} In DLCS24, the Lung-RADS category flagged {nm(lrA.diff[0])} more per 1000 (95% CI: {nm(lrA.diff[1])}, {nm(lrA.diff[2])}).</p>
    </figure>
    <figure>
      <figcaption><span class="pl">B</span> Benign nodules flagged <small>when every score reaches the sensitivity of the 8-mm threshold</small></figcaption>
      <div set:html={panel("b")} />
      <p class="take">{fmB.every((d: any) => inc0(d.diff)) ? "There was no evidence that the selected foundation model setups flagged fewer benign nodules than the 8-mm threshold (both 95% CIs include 0)." : ""} In DLCS24, the Lung-RADS category flagged {nm(-lrB.diff[0])} fewer per 1000 (95% CI: {nm(-lrB.diff[2])}, {nm(-lrB.diff[1])} fewer), at a sensitivity of {lrB.sens.toFixed(2)}.</p>
    </figure>
  </div>
  <p class="ptnote">Markers: red square, 8-mm threshold (its own rate, marker at 0); blue triangle, Brock model; open diamond, Lung-RADS category (DLCS24 only); dark circle, selected FM setup. Bold values have a 95% CI that excludes 0 (2000 bootstrap resamples of participants). † Diameter cutoff {cutoff} mm, matched to the 8-mm sensitivity. ‡ Lung-RADS steps past the target sensitivity (here {lrB.sens.toFixed(2)}). Panel B uses the test labels to set each threshold. Post hoc. From Paper 1, Figure 6.</p>
</div>

<style>
  .pt { background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 18px 20px; box-shadow: var(--shadow); }
  .ptgrid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
  @media (max-width: 980px) { .ptgrid { grid-template-columns: 1fr; } }
  figure { margin: 0; }
  figcaption { font-family: var(--font-head); font-size: 1.12rem; font-weight: 700; color: var(--head); margin-bottom: 4px; }
  figcaption small { display: block; font-family: var(--font); font-size: .8rem; font-weight: 500; color: var(--muted); margin-top: 2px; }
  .pl { display: inline-grid; place-items: center; width: 24px; height: 24px; border-radius: 6px; background: var(--az-red); color: #fff; font-family: var(--font); font-size: .82rem; margin-right: 6px; }
  figure :global(svg) { width: 100%; height: auto; display: block; margin-top: 6px; }
  .take { font-size: .9rem; margin: 8px 0 0; padding: 10px 12px; background: var(--panel); border-left: 3px solid var(--az-red); border-radius: 6px; }
  .ptnote { font-size: .78rem; color: var(--muted); margin: 14px 0 0; }
</style>
